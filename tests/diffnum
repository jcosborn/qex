#!/usr/bin/env python3
# Compare numeric output with relative and optional field-specific absolute tolerances.
import argparse
from itertools import zip_longest
import math
import re
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("reference")
parser.add_argument("actual")
parser.add_argument("relative_precision", nargs="?", type=float, default=1e-12)
parser.add_argument("split_chars", nargs="?", default=" \t[\\],")
parser.add_argument(
  "--atol-after", nargs=2, action="append", default=[], metavar=("LABEL", "ATOL"),
  help="add ATOL to the relative allowance for a number immediately after LABEL; repeatable",
)
args = parser.parse_args()
rel = args.relative_precision
if not math.isfinite(rel) or rel < 0:
  parser.error("relative precision must be finite and nonnegative")
absolute = {}
for label, value in args.atol_after:
  try:
    atol = float(value)
  except ValueError:
    parser.error(f"invalid absolute tolerance: {value}")
  if not math.isfinite(atol) or atol < 0:
    parser.error("absolute tolerances must be finite and nonnegative")
  absolute[label] = atol

with open(args.reference) as f:
  lines1 = [line.strip() for line in f]
with open(args.actual) as f:
  lines2 = [line.strip() for line in f]

err = False
for line_number, (line1, line2) in enumerate(zip_longest(lines1, lines2), 1):
  if line1 is None or line2 is None:
    print(f"Line {line_number}: missing line in {'reference' if line1 is None else 'actual'}")
    err = True
    continue
  s1 = re.split('[' + args.split_chars + ']+', line1)
  s2 = re.split('[' + args.split_chars + ']+', line2)
  if len(s1) != len(s2):
    print(f"Line {line_number}: field counts differ ({len(s1)} != {len(s2)})")
    err = True
    continue
  for i, (t1, t2) in enumerate(zip(s1, s2)):
    try:
      f1, f2 = float(t1), float(t2)
    except ValueError:
      if t1 != t2:
        print(f"Line {line_number}, field {i}: {t1!r} != {t2!r}")
        err = True
      continue
    if not math.isfinite(f1) or not math.isfinite(f2):
      print(f"Line {line_number}, field {i}: nonfinite value ({t1}, {t2})")
      err = True
      continue

    scale = abs(0.5 * f1 + 0.5 * f2)
    atol = absolute.get(s1[i-1], 0.0) if i > 0 and s1[i-1] == s2[i-1] else 0.0
    tolerance = atol + rel * scale
    difference = abs(f1 - f2)
    if difference > tolerance:
      print(f"Line {line_number}, field {i}: {t1} != {t2}; "
            f"absolute error {difference:.6g} > tolerance {tolerance:.6g} "
            f"(atol={atol:.6g}, rtol={rel:.6g}, scale={scale:.6g})")
      err = True

sys.exit(1 if err else 0)
