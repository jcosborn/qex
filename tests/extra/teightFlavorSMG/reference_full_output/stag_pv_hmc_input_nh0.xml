<?xml version="1.0"?>
<qex>
  <hmc>
    <tau>0.15</tau>
    <multirate_scheme>nested</multirate_scheme>
    <g_steps>2</g_steps>
    <sg_steps>1</sg_steps>
    <f_steps>3</f_steps>
    <pv_steps>3</pv_steps>
    <gauge_int_alg>2MN</gauge_int_alg>
    <smeared_gauge_int_alg>2MN</smeared_gauge_int_alg>
    <ferm_int_alg>2MN</ferm_int_alg>
    <pv_int_alg>2MN</pv_int_alg>
    <no_metropolis_until>0</no_metropolis_until>
  </hmc>
  <config_opts>
    <start_config>0</start_config>
    <start>cold</start>
  </config_opts>
  <rng>
    <rng_type>RngMilc6</rng_type>
    <parallel_seed>987654321</parallel_seed>
    <serial_seed>987654321</serial_seed>
  </rng>
  <action>
    <geom>
      <Ns>4</Ns>
      <Nt>4</Nt>
      <num_Ns>3</num_Ns>
      <num_Nt>1</num_Nt>
      <bc>pppa</bc>
    </geom>
    <gauge>
      <gauge_act>adjoint</gauge_act>
      <beta>6.0</beta>
      <adjoint>
        <adj_fac>-0.25</adj_fac>
      </adjoint>
      <rect>
        <c1>0.0</c1>
      </rect>
    </gauge>
    <smeared_gauge>
       <sg_opt>0</sg_opt>
       <smeared_gauge_act>adjoint</smeared_gauge_act>
       <sm_beta>6.0</sm_beta>
       <adjoint>
         <sm_adj_fac>-0.25</sm_adj_fac>
       </adjoint>
       <rect>
         <sm_c1>0.0</sm_c1>
       </rect>
    </smeared_gauge>
    <ferm>
      <Nf>2</Nf>
      <mass>0.05</mass>
      <preconditioner>none</preconditioner>
      <mass_h>0.3</mass_h>
    </ferm>
    <pv>
      <num_pv>8</num_pv>
      <mass_pv>0.75</mass_pv>
    </pv>
  </action>
  <smearing>
    <gauge_smearing>nhyp</gauge_smearing>
    <matter_smearing>nhyp</matter_smearing>
    <nhyp_smearing>
      <alpha_1>0.4</alpha_1>
      <alpha_2>0.5</alpha_2>
      <alpha_3>0.5</alpha_3>
    </nhyp_smearing>
  </smearing>
  <solver>
    <a_tol>1e-24</a_tol>
    <a_maxits>10000</a_maxits>
    <f_tol>1e-16</f_tol>
    <f_maxits>10000</f_maxits>
    <check_solvers>0</check_solvers>
  </solver>
  <extra>
    <basic_meas>
      <plaq>
        <plaq_freq>1</plaq_freq>
        <plaq_verbose>true</plaq_verbose>
      </plaq>
      <ploop_freq>1</ploop_freq>
    </basic_meas>
    <hmc_checks>
      <rev_check_freq>0</rev_check_freq>
    </hmc_checks>
  </extra>
</qex>
